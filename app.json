{
  "expo": {
    "name": "Chippers",
    "slug": "chippers",
    "scheme": "chipperapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Logos/C.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/Logos/Final Logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ead699"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chippers.chippers",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "appEnv": "production",
      "devStartAt": "reflect",
      "acknowledgementsEnabled": true,
      "router": {},
      "eas": {
        "projectId": "9890f3ca-5132-4b62-812b-ab336970d9e1"
      }
    },
    "owner": "snguyen999",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9890f3ca-5132-4b62-812b-ab336970d9e1"
    }
  }
}
